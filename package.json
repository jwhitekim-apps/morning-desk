{
  "name": "morning-desk",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "sources/*",
    "app"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w app"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^9.17.0",
    "fast-check": "^3.23.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
